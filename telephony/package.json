{
  "name": "clccrm-telephony-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Telephony Integration Service — runs on the Ubuntu VPS beside Asterisk 22 + VICIdial. The ONLY thing the CRM backend talks to. Bridges CRM <-> VICIdial <-> Asterisk. SIP-provider independent.",
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "gen-secrets": "node -e \"const c=require('crypto');['CRM_API_KEY','CRM_HMAC_SECRET','WEBHOOK_API_KEY','WEBHOOK_HMAC_SECRET','AMI_SECRET'].forEach(k=>console.log(k+'='+c.randomBytes(24).toString('hex')))\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  }
}

[Unit]
Description=CRM Telephony Integration Service
After=network-online.target asterisk.service mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=telephony
Group=telephony
WorkingDirectory=/opt/telephony
EnvironmentFile=/opt/telephony/.env
ExecStart=/usr/bin/node /opt/telephony/src/server.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/telephony/data /opt/telephony/logs
# recordings dir is read-only to this service
ReadOnlyPaths=/var/spool/asterisk/monitor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

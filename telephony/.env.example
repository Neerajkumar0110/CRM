# ======================================================================
#  Telephony Integration Service — VPS-side environment
#  Copy to  /opt/telephony/.env  and fill in. NEVER commit the real .env.
#  Generate the secrets:  npm run gen-secrets
# ======================================================================

# --- this service ---
PORT=4000
BIND=127.0.0.1                 # nginx terminates TLS and proxies to this
NODE_ENV=production
LOG_LEVEL=info

# --- CRM backend (VPS -> CRM webhooks) ---
CRM_BACKEND_URL=https://your-crm-backend.vercel.app
# Path the CRM exposes for events (matches backend/src/routes/appRoutes/telephonyWebhookApi.js)
CRM_WEBHOOK_PATH=/api/telephony/events
# Signing for VPS -> CRM. Must equal the CRM's TELEPHONY_WEBHOOK_* values.
WEBHOOK_API_KEY=
WEBHOOK_HMAC_SECRET=

# --- CRM -> VPS (this service verifies inbound requests from the CRM) ---
# Must equal the CRM's TELEPHONY_API_KEY / TELEPHONY_HMAC_SECRET.
CRM_API_KEY=
CRM_HMAC_SECRET=
CRM_REQUEST_TOLERANCE_SEC=300

# --- Asterisk AMI (localhost only — never exposed) ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=crm
AMI_SECRET=
# Dialplan context used to originate outbound calls (see asterisk/extensions_crm.conf.tpl)
AMI_OUTBOUND_CONTEXT=crm-outbound
AMI_INTERNAL_CONTEXT=crm-internal
# How the service reaches an agent's phone. {ext} is replaced with the agent extension.
AGENT_CHANNEL_TEMPLATE=PJSIP/{ext}

# --- VICIdial local database (127.0.0.1 — NEVER open to the internet) ---
VICIDIAL_DB_HOST=127.0.0.1
VICIDIAL_DB_PORT=3306
VICIDIAL_DB_NAME=asterisk
VICIDIAL_DB_USER=cron
VICIDIAL_DB_PASS=1234
# VICIdial non-agent HTTP API (localhost)
VICIDIAL_API_BASE=http://127.0.0.1/vicidial
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
VICIDIAL_ENABLED=false          # flip to true after Phase 4 (VICIdial verified)

# --- recordings ---
RECORDINGS_DIR=/var/spool/asterisk/monitor
RECORDINGS_MAX_MB=200

# --- disk queue (survives CRM downtime) ---
QUEUE_DIR=/opt/telephony/data/queue
QUEUE_MAX_ATTEMPTS=20

# ======================================================================
#  SIP PROVIDER — PLACEHOLDERS. Do NOT guess values. Leave blank until the
#  provider gives them. `SIP_OUTBOUND_ENABLED=false` keeps PSTN dialing
#  disabled; internal 1001<->1002 testing still works.
# ======================================================================
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
SIP_PORT=
SIP_TRANSPORT=                  # udp | tcp | tls  (ask provider)
SIP_AUTH_MODE=                  # register | ip   (ask provider)
SIP_DID=
SIP_CODECS=                     # e.g. ulaw,alaw  (ask provider)
SIP_NAT=
SIP_OUTBOUND_ENABLED=false
SIP_INBOUND_ENABLED=false

# /etc/fail2ban/jail.d/telephony.local
#
# Copy in, then: sudo systemctl restart fail2ban && sudo fail2ban-client status
#
# Only enables jails for services that actually exist. Whitelist localhost
# and your office/CRM egress so legit traffic is never banned.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true

[nginx-http-auth]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/error.log

[nginx-limit-req]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/error.log

# Asterisk SIP jail — ENABLE ONLY once SIP is exposed (Phase 20). While
# 5060 is firewalled off this does nothing; turning it on early is fine but
# make sure your provider's IP is in ignoreip so registrations aren't
# mistaken for attacks.
[asterisk]
enabled  = false
port     = 5060,5061
logpath  = /var/log/asterisk/messages
maxretry = 6
# ignoreip = 127.0.0.1/8 <PROVIDER_SIGNALLING_IP>
